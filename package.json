{
  "name": "orbit-review",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint . && prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "check:desktop": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "check": "npm run lint && npm run build && npm test && npm run test:rust && npm run check:desktop",
    "diagnose": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --example diagnose"
  },
  "dependencies": {
    "@astryxdesign/core": "0.6.3",
    "@astryxdesign/theme-neutral": "0.6.3",
    "@stylexjs/stylex": "0.19.1",
    "@tauri-apps/api": "^2.12.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.6.3",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.7",
    "vitest": "^4.1.11"
  }
}
